{
  "manifest_version": 3,
  "name": "Laya Decide",
  "version": "0.1.0",
  "description": "POST a Laya decide request and read typed answers.",
  "permissions": ["storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Laya Decide"
  }
}
